# -*-use-nodiscard: We don't make use of nodiscard.
# -*-return-braced-init-list,-*-use-auto: We prefer to be explicit with the types being handled.
# -*-branch-clone: We have a few large if/else trees with complex if expressions. Keeping expressions separated from
#  one another is often cleaner to read than shoving everything into a single if statement just because the outcomes
#  are the same. Such duplicate bodies are typically simple anyway, such as a single function call.
# -*-use-anyofallof: While some for loops could technically be replaced with any_of or all_of, for loops are often
#  easier to read.
# -*-default-arguments: Animate::Set has a default value in one of its parameters. Clang-tidy says that default values
#  in virtual functions are prohibited, but it clearly works given all the calls to Animate::Set without a second
#  parameter.
# -*-flp30-c: AsteroidField::Asteroid::Draw has a loop that uses doubles
# -*-use-override: Many of our panels provide both virtual and override keywords to their functions. While technically
#  redundant, it's not hurting anything to keep.
# -*-pass-by-value: We normally pass strings by const ref. Clang-tidy is saying that most of them can be replaced with
#  passing by value and using std::move. It doesn't make much difference either way.
Checks: '-*-use-nodiscard,-*-return-braced-init-list,-*-use-auto,-*-branch-clone,-*-use-anyofallof,-*-default-arguments,-*-flp30-c,-*-use-override,-*-pass-by-value'

CheckOptions:
  # We commonly make use of narrowing conversions in the codebase.
  - key: cppcoreguidelines-narrowing-conversions.IgnoreConversionFromTypes
    value: 'rep;SDL_Keycode;long;double;int;unsigned int;size_t;size_type;int64_t;uint32_t;float'
